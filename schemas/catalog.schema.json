{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phenomenoner/smart-agentic-engineering-toolkit/schemas/catalog.schema.json",
  "title": "Toolkit skill catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "toolkitVersion", "status", "ownership", "skills"],
  "properties": {
    "schemaVersion": {"const": 1},
    "toolkitVersion": {"type": "string", "minLength": 1},
    "status": {"type": "string"},
    "ownership": {"const": "toolkit-owned"},
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "class", "phase", "profile", "policy", "status", "sourceMode"]
      }
    }
  }
}
