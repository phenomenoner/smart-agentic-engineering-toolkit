{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phenomenoner/smart-agentic-engineering-toolkit/schemas/install-receipt.schema.json",
  "title": "Standalone toolkit install receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "toolkitVersion",
    "sourceRoot",
    "targetRoot",
    "profile",
    "skills",
    "transaction"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "toolkitVersion": {"type": "string", "minLength": 1},
    "sourceCommit": {"type": "null"},
    "sourceRoot": {"type": "string", "minLength": 1},
    "targetRoot": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "skills": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile", "sourceTreeSha256", "installedTreeSha256", "files"],
        "properties": {
          "profile": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "sourceTreeSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "installedTreeSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "length", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "length": {"type": "integer", "minimum": 0},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "completedAt", "backupDirectory", "previousReceipt", "changed"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "completedAt": {"type": "string", "format": "date-time"},
        "backupDirectory": {"type": "string", "minLength": 1},
        "previousReceipt": {"type": ["string", "null"]},
        "changed": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "uniqueItems": true
        }
      }
    }
  }
}
